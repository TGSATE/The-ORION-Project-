/-- Multiply out a row of exponents against the 15 primes. -/
public def expand (es : List ℕ) : ℕ := ((monsterPrimes.zip es).map fun pe => pe.1 ^ pe.2).prod

/-- The file has one row per irreducible representation: 194 of them. -/
public theorem rows_length : irrepsRows.length = 194 := by decide +kernel

/-- There are 194 dimensions in the OEIS list. -/
public theorem dims_length : monsterDims.length = 194 := by decide +kernel

/-- Every row index is used exactly once: the indices are a rearrangement of `0, …, 193`. -/
public theorem row_indices_perm : (irrepsRows.map (·.1)).Perm (List.range 194) := by
  decide +kernel

/-- Every row has exactly 15 exponents. -/
public theorem rows_have_fifteen_exponents : irrepsRows.all (fun r => r.2.1.length == 15) = true := by
  decide +kernel

/-- **Every row is right:** its prime powers multiply back to the OEIS dimension. -/
public theorem rows_match_dimensions :
    irrepsRows.all (fun r => expand r.2.1 == monsterDims.getD r.1 0) = true := by
  decide +kernel

/-- **The last column is right:** it is the sum of the row's exponents. -/
public theorem row_sums_correct : irrepsRows.all (fun r => r.2.1.sum == r.2.2) = true := by
  decide +kernel

/-- The rows are sorted by exponent sum, largest first. -/
public theorem rows_sorted_by_sum :
    (irrepsRows.map (·.2.2)).Pairwise (· ≥ ·) := by
  decide +kernel

/-- The smallest nontrivial representation: `196883 = 47 × 59 × 71`. -/
public theorem dim_one : monsterDims.getD 1 0 = 196883 ∧ 196883 = 47 * 59 * 71 := by
  decide +kernel

/-- **The squares of the 194 dimensions add up to the order of the Monster.** -/
public theorem sum_sq_dims_eq_order : (monsterDims.map (· ^ 2)).sum = monsterOrder := by
  decide +kernel

end R15.MonsterTable
